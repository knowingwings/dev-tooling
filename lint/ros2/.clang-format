# Close to the ROS 2 code style (Google base, 100 cols, braces on their own line for
# functions/classes/namespaces). If you prefer the exact upstream file, ament_clang_format
# ships one: see ament_clang_format/configuration/.clang-format in your ROS install.
---
BasedOnStyle: Google
ColumnLimit: 100
AccessModifierOffset: -2
AlignAfterOpenBracket: AlwaysBreak
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
ConstructorInitializerIndentWidth: 0
ContinuationIndentWidth: 2
DerivePointerAlignment: false
PointerAlignment: Middle
ReflowComments: false
IncludeBlocks: Preserve
...
