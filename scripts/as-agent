#!/usr/bin/env bash
# Run a git or gh command as one of your agent roles (a GitHub App you own), so every PR, review,
# commit and push shows which role did it, with you as co-author.
#
#   as-agent <role> <command...>    e.g. as-agent builder git push -u origin HEAD
#                                        as-agent reviewer gh pr review 12 --approve -b "..."
#   as-agent setup <role>           look up the App's bot identity once and save it
#   as-agent whoami <role>          show the identity a role uses
#   as-agent token <role>           print an installation token for this repo (cached ~55 min)
#   as-agent jwt <role>             print a signed App JWT (for debugging)
#
# Config, never committed (default ~/.config/dev-tooling/agents, override DEV_TOOLING_AGENTS_DIR):
#   owner.env    OWNER_NAME="Your Name"  OWNER_EMAIL="<id>+<login>@users.noreply.github.com"
#   <role>.env   CLIENT_ID=Iv23...       (BOT_LOGIN and BOT_ID are added by `as-agent setup <role>`)
#                KEY=op://<vault>/<item>/<field>   read the private key from 1Password (op CLI) when
#                                                  signing; nothing is stored on disk
#   <role>.pem   or keep the private key as a file instead (chmod 600); used when KEY isn't set
# CLIENT_ID can be an op:// reference too. Set DEV_TOOLING_NO_TOKEN_CACHE=1 to keep even the
# 1-hour installation tokens off disk (you'll be asked to unlock 1Password more often).
#
# Every `git commit` run through as-agent gets "Co-authored-by: OWNER" added, so the history keeps
# your attribution. Pushes use the App's token over HTTPS even if the remote is SSH.
set -euo pipefail

DIR="${DEV_TOOLING_AGENTS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dev-tooling/agents}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/dev-tooling"
API="${GITHUB_API_URL:-https://api.github.com}"
PY="$(command -v python3 || command -v python || true)"

die() { echo "as-agent: $*" >&2; exit 1; }
json() { [[ -n "$PY" ]] || die "needs python3 to read API responses"; "$PY" -c "import json,sys; print(json.load(sys.stdin)$1)"; }
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

load_role() {
  local role="$1"
  [[ "$role" =~ ^[a-z][a-z0-9-]*$ ]] || die "role names are lowercase words, got '$role'"
  [[ -f "$DIR/$role.env" ]] || die "no $DIR/$role.env (see docs/SETUP.md, Agent roles)"
  CLIENT_ID=""; BOT_LOGIN=""; BOT_ID=""; KEY="$DIR/$role.pem"
  # shellcheck disable=SC1090
  source "$DIR/$role.env"
  [[ -n "$CLIENT_ID" ]] || die "CLIENT_ID missing in $DIR/$role.env"
  [[ "$CLIENT_ID" == op://* ]] && CLIENT_ID="$(op_read "$CLIENT_ID")"
  OWNER_NAME=""; OWNER_EMAIL=""
  # shellcheck disable=SC1091
  [[ -f "$DIR/owner.env" ]] && source "$DIR/owner.env"
  ROLE="$role"
}

op_read() {
  command -v op >/dev/null || die "$1 is a 1Password reference but the op CLI isn't installed"
  op read --no-newline "$1" || die "1Password couldn't read $1 (signed in? run: op signin)"
}

TMP_KEY=""
trap 'rm -f "$TMP_KEY"' EXIT

make_jwt() {
  local key_file="$KEY" now header payload sig
  if [[ "$KEY" == op://* ]]; then
    TMP_KEY="$(mktemp)"
    chmod 600 "$TMP_KEY"
    op_read "$KEY" > "$TMP_KEY"
    key_file="$TMP_KEY"
  fi
  [[ -f "$key_file" ]] || die "private key not found: $key_file"
  now="$(date +%s)"
  header="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
  payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$CLIENT_ID" | b64url)"
  sig="$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$key_file" -binary | b64url)"
  [[ -n "$TMP_KEY" ]] && rm -f "$TMP_KEY" && TMP_KEY=""
  printf '%s.%s.%s' "$header" "$payload" "$sig"
}

api() {
  local method="$1" path="$2" auth="$3"
  curl -fsS -X "$method" -H "Accept: application/vnd.github+json" -H "Authorization: Bearer $auth" \
    -H "X-GitHub-Api-Version: 2022-11-28" "$API$path"
}

repo_slug() {
  git remote get-url origin 2>/dev/null | sed -nE 's#.*github\.com[:/]+([^/]+/[^/.]+)(\.git)?/?$#\1#p'
}

install_token() {
  if [[ -n "${DEV_TOOLING_AGENT_TOKEN:-}" ]]; then printf '%s' "$DEV_TOOLING_AGENT_TOKEN"; return; fi
  local slug cache_file jwt inst now
  slug="$(repo_slug)"
  [[ -n "$slug" ]] || die "no GitHub origin remote here, so no installation to get a token for"
  cache_file="$CACHE/$ROLE-${slug//\//_}.token"
  now="$(date +%s)"
  if [[ -z "${DEV_TOOLING_NO_TOKEN_CACHE:-}" && -f "$cache_file" ]]; then
    read -r expires token < "$cache_file" || true
    if [[ -n "${expires:-}" && "$expires" -gt $((now + 300)) ]]; then printf '%s' "$token"; return; fi
  fi
  jwt="$(make_jwt)"
  inst="$(api GET "/repos/$slug/installation" "$jwt" | json "['id']")" \
    || die "the $ROLE App isn't installed on $slug (GitHub > Settings > Applications)"
  token="$(api POST "/app/installations/$inst/access_tokens" "$jwt" | json "['token']")"
  if [[ -z "${DEV_TOOLING_NO_TOKEN_CACHE:-}" ]]; then
    mkdir -p "$CACHE" && umask 077 && printf '%s %s\n' "$((now + 3300))" "$token" > "$cache_file"
  fi
  printf '%s' "$token"
}

cmd_setup() {
  load_role "$1"
  local jwt slug id
  jwt="$(make_jwt)"
  slug="$(api GET /app "$jwt" | json "['slug']")" || die "GitHub rejected the JWT: check CLIENT_ID and $KEY"
  id="$(curl -fsS "$API/users/${slug}%5Bbot%5D" | json "['id']")"
  grep -v '^BOT_' "$DIR/$ROLE.env" > "$DIR/$ROLE.env.tmp" || true
  printf 'BOT_LOGIN="%s[bot]"\nBOT_ID=%s\n' "$slug" "$id" >> "$DIR/$ROLE.env.tmp"
  mv "$DIR/$ROLE.env.tmp" "$DIR/$ROLE.env"
  echo "$ROLE acts as ${slug}[bot] (id $id)"
}

identity() {
  [[ -n "$BOT_LOGIN" && -n "$BOT_ID" ]] || die "run 'as-agent setup $ROLE' first"
  BOT_EMAIL="${BOT_ID}+${BOT_LOGIN}@users.noreply.github.com"
}

run_as() {
  load_role "$1"; shift
  [[ $# -gt 0 ]] || die "nothing to run: as-agent $ROLE <command...>"
  identity
  local token
  token="$(install_token)"
  export GH_TOKEN="$token" GITHUB_TOKEN="$token" DEV_TOOLING_AGENT_TOKEN="$token"
  export GIT_AUTHOR_NAME="$BOT_LOGIN" GIT_AUTHOR_EMAIL="$BOT_EMAIL"
  export GIT_COMMITTER_NAME="$BOT_LOGIN" GIT_COMMITTER_EMAIL="$BOT_EMAIL"
  export GIT_CONFIG_COUNT=3
  export GIT_CONFIG_KEY_0="url.https://github.com/.insteadOf" GIT_CONFIG_VALUE_0="git@github.com:"
  export GIT_CONFIG_KEY_1="credential.https://github.com.helper" GIT_CONFIG_VALUE_1=""
  export GIT_CONFIG_KEY_2="credential.https://github.com.helper"
  # shellcheck disable=SC2016
  export GIT_CONFIG_VALUE_2='!f() { echo username=x-access-token; echo "password=$DEV_TOOLING_AGENT_TOKEN"; }; f'
  export DEV_TOOLING_ROLE="$ROLE"

  if [[ "${1:-}" == git && "${2:-}" == commit && -n "$OWNER_NAME" && -n "$OWNER_EMAIL" ]]; then
    shift 2
    exec git commit --trailer "Co-authored-by: $OWNER_NAME <$OWNER_EMAIL>" "$@"
  fi
  exec "$@"
}

case "${1:-}" in
  ""|-h|--help) sed -n '2,24p' "$0"; exit 0 ;;
  setup)  [[ $# -eq 2 ]] || die "usage: as-agent setup <role>"; cmd_setup "$2" ;;
  whoami) [[ $# -eq 2 ]] || die "usage: as-agent whoami <role>"; load_role "$2"; identity
          echo "$BOT_LOGIN <$BOT_EMAIL>, co-author: ${OWNER_NAME:-none} <${OWNER_EMAIL:-}>" ;;
  token)  [[ $# -eq 2 ]] || die "usage: as-agent token <role>"; load_role "$2"; install_token; echo ;;
  jwt)    [[ $# -eq 2 ]] || die "usage: as-agent jwt <role>"; load_role "$2"; make_jwt; echo ;;
  *)      run_as "$@" ;;
esac
