{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "rust: build",
      "type": "cargo",
      "command": "build",
      "args": ["--workspace"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "rust: clippy",
      "type": "cargo",
      "command": "clippy",
      "args": ["--workspace", "--all-targets", "--", "-D", "warnings"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "rust: test",
      "type": "cargo",
      "command": "test",
      "args": ["--workspace"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "lint: all (pre-commit)",
      "type": "shell",
      "command": "pre-commit run --all-files",
      "problemMatcher": ["$rustc"]
    }
  ]
}
