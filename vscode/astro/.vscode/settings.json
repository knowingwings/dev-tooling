// Astro site. The Astro extension gives completion and type errors in .astro files; Prettier formats
// on save and ESLint shows lint errors inline, with the same configs the hooks use.
{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "[astro]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "prettier.requireConfig": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "astro"],
  // The project's TypeScript, so the editor and astro check agree.
  "typescript.tsdk": "node_modules/typescript/lib",
  "files.exclude": { "dist": true, ".astro": true }
}
