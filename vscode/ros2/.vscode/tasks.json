// Ctrl+Shift+B = build. Terminal > Run Task for the rest.
// Problem matchers put compiler errors AND lint-kit errors into the Problems panel (Ctrl+Shift+M).
{
  "version": "2.0.0",
  "options": {
    "shell": { "executable": "bash", "args": ["--init-file", "${workspaceFolder}/.vscode/ros_bashrc", "-ic"] }
  },
  "tasks": [
    {
      "label": "ros2: build",
      "type": "shell",
      "command": "colcon build --symlink-install --cmake-args -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCMAKE_BUILD_TYPE=RelWithDebInfo && .vscode/post_build.sh",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": { "base": "$gcc", "fileLocation": "absolute" }
    },
    {
      "label": "ros2: build package",
      "type": "shell",
      "command": "colcon build --symlink-install --packages-up-to ${input:package} --cmake-args -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCMAKE_BUILD_TYPE=RelWithDebInfo && .vscode/post_build.sh",
      "group": "build",
      "problemMatcher": { "base": "$gcc", "fileLocation": "absolute" }
    },
    {
      "label": "ros2: test package",
      "type": "shell",
      "command": "colcon test --packages-select ${input:package} && colcon test-result --verbose",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "lint: all (pre-commit)",
      "type": "shell",
      "command": "pre-commit run --all-files",
      "problemMatcher": [
        {
          "owner": "check-patterns",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "pattern": { "regexp": "^(.+?):(\\d+):(\\d+): \\[([\\w-]+)\\] (.*)$", "file": 1, "line": 2, "column": 3, "code": 4, "message": 5 },
          "severity": "error"
        },
        {
          "owner": "ruff",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "pattern": { "regexp": "^(.+?\\.py):(\\d+):(\\d+): ([A-Z]+\\d+) (.*)$", "file": 1, "line": 2, "column": 3, "code": 4, "message": 5 },
          "severity": "warning"
        }
      ]
    },
    {
      "label": "lint: clang-tidy",
      "type": "shell",
      "command": "pre-commit run clang-tidy --hook-stage pre-push --all-files",
      "problemMatcher": { "base": "$gcc", "fileLocation": "absolute" }
    },
    {
      "label": "ros2: clean",
      "type": "shell",
      "command": "rm -rf build install log",
      "problemMatcher": []
    }
  ],
  "inputs": [
    { "id": "package", "type": "promptString", "description": "Package name" }
  ]
}
